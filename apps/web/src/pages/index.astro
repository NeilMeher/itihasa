---
import Beta from '../layouts/Beta.astro';
import { areas, lessons } from '../lib/library';
---
<Beta title="Explore stories and the sky">
  <div class="home-hero">
    <div>
      <p class="eyebrow">Stories, skies &amp; sources</p>
      <h1>What did Vyāsa mean by <em>“ahead”?</em></h1>
      <p class="lede">Two stars. One verse. Read the omen, move the sky, and see what the passage can tell us.</p>
      <div class="intro-links">
        <a class="start-link" href="/arundhati/">Explore the two stars <span aria-hidden="true">→</span></a>
        <a href="/search/">Search the library</a>
      </div>
    </div>
    <figure class="home-plot" aria-label="Illustrative Alcor and Mizar meridian diagram">
      <span class="plot-meridian">Meridian</span>
      <span class="home-star home-alcor">Alcor</span>
      <span class="home-star home-mizar">Mizar</span>
      <figcaption>Illustrative sky · Arundhatī and Vasiṣṭha</figcaption>
    </figure>
  </div>
  <section class="beta-band" aria-labelledby="routes">
    <h2 id="routes">Find a question</h2>
    <div class="link-grid">
      {areas.map((area) => (
        <article><h3><a href={area.url}>{area.title}</a></h3><p>{area.text}</p></article>
      ))}
    </div>
  </section>
  <section class="beta-band" aria-labelledby="festival-links">
    <h2 id="festival-links">From story to festival</h2>
    <div class="link-grid">{lessons.map((lesson) => (
      <article><h3><a href={lesson.url}>{lesson.title}</a></h3><p>{lesson.text}</p></article>
    ))}</div>
  </section>
</Beta>
