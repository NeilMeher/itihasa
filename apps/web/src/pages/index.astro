---
import SkyPlayer from '../components/SkyPlayer';
import rawEvidence from '../../../../content/arundhati-evidence.json';
import type { EvidenceBundle } from '../../../../packages/contracts/evidence';
import '../styles/global.css';

// research/check_evidence.py validates this JSON against the canonical models.
const { sources, passage, clue, sky, historical } = rawEvidence as EvidenceBundle;
const passageSource = sources.find((source) => source.id === passage.source_id);
const clueSource = sources.find((source) => source.id === clue.source_id);
if (!passageSource || !clueSource) throw new Error('Missing investigation source');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Read an omen from the Mahābhārata and explore what it would mean for Arundhatī to cross the meridian first." />
    <title>Arundhatī &amp; Vasiṣṭha · Itihāsa</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to investigation</a>
    <header class="masthead">
      <div class="wrap masthead-inner">
        <a class="wordmark" href="/" aria-label="Itihāsa home">Itihāsa<span aria-hidden="true">✦</span></a>
        <nav aria-label="On this page">
          <a href="#sky">Sky demo</a>
          <a href="#sources">Sources</a>
        </nav>
      </div>
    </header>

    <main id="main" class="wrap">
      <div class="opening">
        <section class="intro" aria-labelledby="title">
          <p class="eyebrow">Mahābhārata · {passage.locator}</p>
          <h1 id="title">What did Vyāsa mean by <em>“ahead”?</em></h1>
          <p class="lede">Before the battle at Kurukṣetra, Vyāsa tells King Dhṛtarāṣṭra that Arundhatī has put Vasiṣṭha behind her. Nilesh Nilkanth Oak reads the omen as a clue about two stars.</p>

          <blockquote class="verse" cite={passageSource.url}>
            <p class="sanskrit" lang="sa-Deva">{passage.devanagari.map((line) => <span>{line}</span>)}</p>
            <p>{passage.working_translation}</p>
            <footer><a href="#passage-source">{passage.translation_credit} · BORI {passage.locator}</a></footer>
          </blockquote>
          <a class="text-link start-link" href="#sky">Explore the two stars <span aria-hidden="true">↓</span></a>
        </section>

        <SkyPlayer client:load fixture={sky} />
      </div>

      <section id="sources" class="evidence" aria-labelledby="evidence-title">
        <h2 id="evidence-title">Sources &amp; method</h2>
        <details id="passage-source" open>
          <summary>The passage <span>BORI {passage.locator}</span></summary>
          <div class="detail-content">
            <p lang="sa-Latn" class="transliteration">{passage.source_transliteration.map((line) => <span>{line}</span>)}</p>
            <p>{passageSource.edition}, lines {passage.source_locator}. {passage.review_note}</p>
            <p><a href={passageSource.url}>Read the Sanskrit e-text</a></p>
          </div>
        </details>
        <details>
          <summary>Oak’s interpretation <span>Meridian crossing</span></summary>
          <div class="detail-content">
            <p>{clue.interpretation} The local meridian is an imaginary line running from north to south through the point directly overhead.</p>
            <p>{clue.measure} {clue.uncertainty}</p>
            <p><a href={clueSource.url}>Read Oak’s original explanation and see his figures</a></p>
          </div>
        </details>
        <details open>
          <summary>Historical result <span>{historical.status === 'unavailable' ? 'Unavailable' : historical.status === 'under_review' ? 'Under review' : 'Reviewed'}</span></summary>
          <div class="detail-content">
            {historical.status === 'unavailable' && <p>{historical.reason}</p>}
            {historical.status === 'under_review' && <p>Run {historical.run.id} is awaiting review.</p>}
            {historical.status === 'reviewed' && (
              <>
                <p>{historical.finding} {historical.uncertainty}</p>
                <p>Reviewed by {historical.review.reviewer} on {historical.review.reviewed_on}.</p>
                <p><a href={historical.output.url}>View the reviewed dataset</a></p>
              </>
            )}
          </div>
        </details>
      </section>
    </main>
  </body>
</html>
