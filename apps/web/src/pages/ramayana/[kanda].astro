---
import Beta from '../../layouts/Beta.astro';
import ChapterReading from '../../components/ChapterReading.astro';
import { kandaUrl, ramaPassageUrl, ramayana, ramayanaIndex, ramayanaReadings, ramayanaSceneUrl } from '../../lib/ramayana';
import registry from '../../../../../content/coverage-registry.json';
import '../../styles/epic-route.css';
export function getStaticPaths() {
  return ramayana.books.map((book) => ({ params: { kanda: String(book.number).padStart(2, '0') }, props: { book } }));
}
const { book } = Astro.props;
const index = ramayanaIndex.books[book.number - 1];
const coverage = registry.works.ramayana.books[book.number - 1];
const entries = new Map(ramayana.episodes.filter((scene) => scene.book === book.number).map((scene) => [scene.chapter, scene]));
---
<Beta title={`${book.name} Kāṇḍa`} summary={book.summary}>
  <header class="beta-intro route-opening">
    <a href="/ramayana/">← Rāmāyaṇa atlas</a>
    <h1>{book.name} Kāṇḍa</h1>
    <p lang="sa-Deva">{book.devanagari}</p>
    <p class="lede">{book.summary}</p>
  </header>
  <section class="beta-band" aria-labelledby="sarga-index">
    <nav class="route-links" aria-label="Neighbouring books">
      {book.number > 1 && <a href={kandaUrl(book.number - 1)}>← {ramayana.books[book.number - 2].name}</a>}
      {book.number < 7 && <a href={kandaUrl(book.number + 1)}>{ramayana.books[book.number].name} →</a>}
    </nav>
    <h2 id="sarga-index">Sarga index</h2>
    <p>A sarga is a chapter. Book {book.number} has {coverage.indexed} Baroda sargas and {coverage.annotated} chapter annotations.</p>
    <ol class="ram-sargas">{index.chapterStarts.map((line, offset) => {
      const sarga = offset + 1;
      const scene = entries.get(sarga);
      const annotation = scene && ramayanaReadings.get(scene.id);
      return <li id={`sarga-${sarga}`}>
        <div class="route-links"><h3>{book.number}.{sarga}</h3><a href={ramaPassageUrl(book.number, line)}>Sanskrit chapter start ↗</a></div>
        {scene && annotation ? <>
          <p>Chapter annotation</p>
          <ChapterReading annotation={annotation} edition="Baroda Critical Edition" textUrl={index.url} graphUrl={`/mind-map/?node=ra-chapter-${book.number}-${sarga}`} />
          <a href={ramayanaSceneUrl(scene.id)}>Open the scene and route →</a>
        </> : <p>Index and primary source only</p>}
        <nav class="route-links" aria-label={`Sargas around ${book.number}.${sarga}`}>
          {sarga > 1 && <a href={`#sarga-${sarga - 1}`}>← {book.number}.{sarga - 1}</a>}
          {sarga < index.chapterStarts.length && <a href={`#sarga-${sarga + 1}`}>{book.number}.{sarga + 1} →</a>}
        </nav>
      </li>;
    })}</ol>
  </section>
</Beta>
