{
  "books": [
    {
      "number": 1,
      "name": "Bāla",
      "devanagari": "बालकाण्ड",
      "title": "The introductions and marriages",
      "summary": "Vālmīki asks what makes a worthy person. The book introduces the princes, Viśvāmitra’s journey and Sītā’s marriage."
    },
    {
      "number": 2,
      "name": "Ayodhyā",
      "devanagari": "अयोध्याकाण्ड",
      "title": "A succession overturned",
      "summary": "The intended coronation becomes exile. Sītā, Lakṣmaṇa and Bharata each decide how to respond."
    },
    {
      "number": 3,
      "name": "Araṇya",
      "devanagari": "अरण्यकाण्ड",
      "title": "Life in the forest",
      "summary": "The exiles settle in Pañcavaṭī. Rāvaṇa abducts Sītā, and Jaṭāyu challenges him."
    },
    {
      "number": 4,
      "name": "Kiṣkindhā",
      "devanagari": "किष्किन्धाकाण्ड",
      "title": "The alliance and the search",
      "summary": "Hanumān brings Rāma to Sugrīva. The brothers’ struggle for Kiṣkindhā and the search for Sītā follow."
    },
    {
      "number": 5,
      "name": "Sundara",
      "devanagari": "सुन्दरकाण्ड",
      "title": "Hanumān crosses to Laṅkā",
      "summary": "Hanumān finds Sītā and carries information across the sea. Sītā’s own decisions shape the encounter."
    },
    {
      "number": 6,
      "name": "Yuddha",
      "devanagari": "युद्धकाण्ड",
      "title": "The war and return",
      "summary": "The allied force crosses the sea. The war ends, and reunion raises questions of trust before the return to Ayodhyā."
    },
    {
      "number": 7,
      "name": "Uttara",
      "devanagari": "उत्तरकाण्ड",
      "title": "The costs of being king",
      "summary": "The later book looks backward to Laṅkā and forward to Sītā’s renewed exile, her sons, and the final gathering."
    }
  ],
