  "people": [
    {
      "id": "mandodari",
      "name": "Mandodarī",
      "devanagari": "मन्दोदरी",
      "summary": "Rāvaṇa’s wife. Her lament shows the war’s effect on the defeated household."
    },
    {
      "id": "kusha",
      "name": "Kuśa",
      "devanagari": "कुश",
      "summary": "One of Sītā’s twin sons. Vālmīki names him in the forest."
    },
    {
      "id": "lava",
      "name": "Lava",
      "devanagari": "लव",
      "summary": "One of Sītā’s twin sons. He is raised with Kuśa at the hermitage."
    },
    {
      "id": "sita",
      "name": "Sītā",
      "devanagari": "सीता",
      "summary": "Janaka’s daughter. She chooses exile, questions Hanumān about the rescue, and speaks for herself at the final gathering."
    },
    {
      "id": "rama",
      "name": "Rāma",
      "devanagari": "राम",
      "summary": "Daśaratha’s son. His response to the promises of the court drives the exile and later tests of kingship."
    },
    {
      "id": "lakshmana",
      "name": "Lakṣmaṇa",
      "devanagari": "लक्ष्मण",
      "summary": "Rāma’s brother and companion in the forest. He carries out the second exile order in Uttara."
    },
    {
      "id": "bharata",
      "name": "Bharata",
      "devanagari": "भरत",
      "summary": "Kaikeyī’s son. He seeks Rāma’s return and takes the sandals as a sign of the elder brother’s authority."
    },
    {
      "id": "hanuman",
      "name": "Hanumān",
      "devanagari": "हनुमान",
      "summary": "Sugrīva’s messenger and the envoy who finds Sītā in Laṅkā."
    },
    {
      "id": "sugriva",
      "name": "Sugrīva",
      "devanagari": "सुग्रीव",
      "summary": "Vāli’s brother. His alliance with Rāma helps him recover Kiṣkindhā."
    },
    {
      "id": "vali",
      "name": "Vāli",
      "devanagari": "वालि",
      "summary": "The ruler who challenges Rāma’s reasons for intervening in his fight with Sugrīva."
    },
    {
      "id": "kaikeyi",
      "name": "Kaikeyī",
      "devanagari": "कैकेयी",
      "summary": "Daśaratha’s wife and Bharata’s mother. She invokes the promises he made to her."
    },
    {
      "id": "ravana",
      "name": "Rāvaṇa",
      "devanagari": "रावण",
      "summary": "Ruler of Laṅkā and Vibhīṣaṇa’s brother. He abducts Sītā from the forest."
    },
    {
      "id": "vibhishana",
      "name": "Vibhīṣaṇa",
      "devanagari": "विभीषण",
      "summary": "Rāvaṇa’s brother. He seeks refuge with Rāma and joins the coalition."
    },
    {
      "id": "janaka",
      "name": "Janaka",
      "devanagari": "जनक",
      "summary": "King of Mithilā and Sītā’s father. He tells of finding her during the ploughing."
    },
    {
      "id": "valmiki",
      "name": "Vālmīki",
      "devanagari": "वाल्मीकि",
      "summary": "The poet who opens the work with a question. His hermitage provides a new setting in Uttara."
    },
    {
      "id": "jatayu",
      "name": "Jaṭāyu",
      "devanagari": "जटायु",
      "summary": "An ally of the exiles who confronts Rāvaṇa during Sītā’s abduction."
    },
    {
      "id": "nala-builder",
      "name": "Nala the builder",
      "devanagari": "नल",
      "summary": "The figure commissioned to build the sea crossing in Yuddhakāṇḍa."
    },
    {
      "id": "shatrughna",
      "name": "Śatrughna",
      "devanagari": "शत्रुघ्न",
      "summary": "Daśaratha’s son accompanies Bharata and later asks Cyavana about Lavaṇa’s power."
    }
