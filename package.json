{
  "name": "itihasa",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": { "node": "24.12.0" },
  "workspaces": ["apps/web"],
  "scripts": {
    "dev": "npm run dev --workspace @itihasa/web --",
    "check": "npm run check --workspace @itihasa/web",
    "build": "npm run build --workspace @itihasa/web",
    "preview": "npm run preview --workspace @itihasa/web --",
    "contracts:generate": "json2ts -i packages/contracts/evidence.schema.json -o packages/contracts/evidence.d.ts",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "json-schema-to-typescript": "16.0.0"
  }
}
