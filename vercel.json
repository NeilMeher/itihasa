{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build --workspace @itihasa/web",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/v1/*.py": {
      "includeFiles": "{research/calendar_engine.py,research/calendar_http.py,content/cities.json,content/conventions.json}",
      "excludeFiles": "{apps/**,docs/**,packages/**,.github/**,node_modules/**,research/{[a-b]*,check*,evidence*,fixtures/**,profile*,run*,serve*,test*,uv.lock,verify*,pyproject.toml,.python-version},content/{[a-b]*,[d-z]*,coverage*}}"
    }
  }
}
